{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/styles/theme",
  "title": "Channel Theme",
  "description": "A saved channel look used by the review-reel template. Managed with `python -m lib.themes`.",
  "type": "object",
  "required": [
    "version",
    "name",
    "palette",
    "fonts",
    "captions",
    "audio",
    "voice"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,48}$" },
    "description": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "applied_at": { "type": "string" },
    "palette": {
      "type": "object",
      "required": ["background", "text", "muted", "accent"],
      "properties": {
        "background": { "$ref": "#/$defs/hex" },
        "text": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
      "required": ["display", "text"],
      "properties": {
        "display": { "type": "string" },
        "text": { "type": "string" },
        "scripts": {
          "type": "array",
          "description": "Non-Latin scripts shown on screen. Loads a fallback font so that text is not blank.",
          "items": { "type": "string", "enum": ["tamil", "devanagari"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "captions": {
      "type": "object",
      "properties": {
        "size": { "type": "integer", "minimum": 30, "maximum": 110 },
        "weight": { "type": "integer", "enum": [600, 700, 800] },
        "top": { "type": "integer", "minimum": 900, "maximum": 1650 },
        "left": { "type": "integer", "minimum": 0, "maximum": 300 },
        "right": { "type": "integer", "minimum": 0, "maximum": 300 },
        "max_chars": { "type": "integer", "minimum": 20, "maximum": 90 },
        "scrim": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "properties": {
        "size": { "type": "integer", "minimum": 30, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "spring_damping": { "type": "number", "minimum": 5, "maximum": 40 },
        "whip_frames": { "type": "integer", "minimum": 0, "maximum": 12 },
        "vignette": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "description": "Opening and closing device. aperture = the light circle that opens into the first reveal and closes at the end.",
      "properties": {
        "open": { "type": "string", "enum": ["aperture", "fade", "cut"] },
        "close": { "type": "string", "enum": ["aperture", "fade", "cut"] }
      },
      "additionalProperties": false
    },
    "intro": {
      "type": "object",
      "properties": {
        "cover_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Show the cover card for this long at the start, so first-frame previews are not black. 0 = off."
        }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "music_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "music_ducked_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "loudness_lufs": { "type": "number", "minimum": -30, "maximum": -8 },
        "sfx": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "reference_id": { "type": "string" },
        "voice": { "type": "string", "description": "Prebuilt voice name, for providers that use one (gemini_tts: Puck, Charon, Kore, ...)." },
        "style": { "type": "string", "description": "Plain-language delivery direction, for providers that take one (gemini_tts)." },
        "temperature": { "type": "number", "minimum": 0, "maximum": 1.5 },
        "tempo": { "type": "number", "minimum": 0.8, "maximum": 1.3 },
        "gap_seconds": { "type": "number", "minimum": 0, "maximum": 1.5 },
        "lead_seconds": { "type": "number", "minimum": 0, "maximum": 2 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}
